#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE                   &kp Q      &kp W         &kp E         &kp R  &kp T        &kp Y              &kp U                    &kp I                &kp O           &kp P           &mt RC(SPACE) RS(RG(NUMBER_4))
&lt 6 TAB                    &kp A      &kp S         &kp D         &kp F  &kp G        &kp H              &kp J                    &kp K                &kp L           &kp MINUS       &kp LG(C)
&kp C_PLAY_PAUSE             &kp Z      &kp X         &kp C         &kp V  &kp B        &mt DELETE DELETE  &mt BACKSPACE BACKSPACE  &kp N                &kp M           &mkp MB1        &mkp MB2                        &lt 4 UP_ARROW  &mt RSHFT LG(V)
&mt LEFT_SHIFT LC(UP_ARROW)  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &mo 4  &lt 5 SPACE  &lt 2 BACKSPACE    &lt 3 ENTER              &mt RIGHT_GUI RG(C)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        L1_Trackball {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mo 4   &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L2_Tenkey {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &kp KP_ASTERISK  &kp PRCNT
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &kp KP_SLASH     &kp DLLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT  &trans  &kp LPAR
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &kp KP_NUMBER_0  &kp KP_EQUAL     &trans           &trans           &trans
            >;
        };

        L3_Mouseaction {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp RG(Q)         &mkp MB4                &kp RS(RG(R))       &mkp MB5                 &trans  &kp RS(RG(N4))
&trans  &trans  &trans  &trans  &trans  &trans  &kp RC(UP_ARROW)  &kp RA(RG(LEFT_ARROW))  &kp RG(T)           &kp RA(RG(RIGHT_ARROW))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &kp RG(W)               &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)      &trans  &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans                  &trans              &trans                   &trans  &trans
            >;
        };

        L4_Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L5_Mark {
            bindings = <
&trans  &kp AT_SIGN    &kp CARET  &kp SQT        &kp STAR     &trans  &kp EXCLAMATION  &kp QUESTION  &kp PIPE       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&trans  &kp HASH       &kp COLON  &kp SEMICOLON  &kp SLASH    &trans  &kp COMMA        &kp PERIOD    &kp BACKSLASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp AMPERSAND  &trans     &trans         &kp PERCENT  &trans  &trans           &trans        &kp RA(Y)      &kp DOLLAR            &kp UNDERSCORE         &kp LESS_THAN  &kp GREATER_THAN  &trans
&trans  &trans         &trans     &trans         &trans       &trans  &trans           &trans        &trans         &trans                &trans                 &trans
            >;
        };

        L6_Bluetooth {
            bindings = <
&trans  &bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 2  &trans  &trans  &trans  &trans  &bt BT_CLR      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 3  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
