#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE                   &kp Q      &kp W         &kp E         &kp R   &kp T  &kp Y              &kp U                    &kp I                &kp O           &kp P           &mt RC(SPACE) RS(RG(NUMBER_4))
&lt 6 TAB                    &kp A      &kp S         &kp D         &kp F   &kp G  &kp H              &kp J                    &kp K                &kp L           &kp MINUS       &kp RG(V)
&kp C_PLAY_PAUSE             &kp Z      &kp X         &kp C         &kp V   &kp B  &mt DELETE DELETE  &mt BACKSPACE BACKSPACE  &kp N                &kp M           &mkp MB1        &mkp MB2                        &lt 5 UP_ARROW  &mt RSHFT QUESTION
&mt LEFT_SHIFT LC(UP_ARROW)  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans  &mo 5  &lt 2 SPACE        &lt 3 ENTER              &mt RIGHT_GUI RG(C)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        L1_Trackball {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L2_Tenkey {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &kp KP_ASTERISK  &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &kp KP_SLASH     &kp DOLLAR
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &kp KP_EQUAL     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD   &trans  &kp LEFT_PARENTHESIS
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans           &kp NUMBER_0     &trans           &trans           &trans
            >;
        };

        L3_Mouseaction {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4                &kp RS(RG(ASTRK))   &mkp MB5                 &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RA(RG(LEFT_ARROW))  &kp RG(T)           &kp RA(RG(RIGHT_ARROW))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RG(W)               &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans              &trans                   &trans  &trans
            >;
        };

        L4_Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L5_Mark {
            bindings = <
&trans  &kp AT_SIGN    &kp CARET  &kp SQT        &kp STAR     &trans  &kp EXCLAMATION  &kp QUESTION  &kp PIPE              &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&trans  &kp HASH       &kp COLON  &kp SEMICOLON  &kp SLASH    &trans  &kp COMMA        &kp PERIOD    &kp NON_US_BACKSLASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp AMPERSAND  &trans     &trans         &kp PERCENT  &trans  &trans           &trans        &kp INT_YEN           &kp DOLLAR            &kp UNDERSCORE         &kp LESS_THAN  &kp GREATER_THAN  &trans
&trans  &trans         &trans     &trans         &trans       &trans  &trans           &trans        &trans                &trans                &trans                 &trans
            >;
        };

        L6_Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
